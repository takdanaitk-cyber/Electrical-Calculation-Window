{
  "name": "electrical-calculator",
  "version": "1.0.0",
  "description": "Electrical Calculator - เครื่องคำนวณงานระบบไฟฟ้าตามมาตรฐาน วสท. 2564",
  "main": "main.js",
  "author": "Electrical Calculator",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.electricalcalculator.app",
    "productName": "Electrical Calculator",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "www/**/*", "package.json"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Electrical Calculator",
      "artifactName": "Electrical-Calculator-Setup-${version}.${ext}"
    },
    "portable": { "artifactName": "Electrical-Calculator-Portable-${version}.${ext}" }
  }
}
